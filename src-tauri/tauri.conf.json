{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GAWWW",
  "version": "0.1.2",
  "identifier": "com.gawww.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GAWWW",
        "width": 1220,
        "height": 850,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Graphics and Design",
    "shortDescription": "Graphical frontend for the awww wallpaper daemon",
    "longDescription": "GAWWW sets and manages Wayland wallpapers through the awww-daemon. It previews images, picks displays, chooses transitions and controls the daemon.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
